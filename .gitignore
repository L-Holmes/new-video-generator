# --- everything a run generates --------------------------------------------
# One hidden folder holds every run's scratch space (.CACHE/<name>-CACHE/),
# and OUTPUT/ every finished video (OUTPUT/<name>-OUTPUT/). Nothing under
# either is worth committing.
.CACHE/
OUTPUT/
tmp_stitch/
temp/

# written by a direct `uv run ___splitting_and_labelling/main.py`, and by
# TESTING-RESOURCES/test_integration.py
TEST_RESULTS/
TESTING-RESOURCES/testrun/

