      }
    ],
    "manual_intervention": false
  },
  "Cinnamon comes from the inner bark of a specific tree native to Sri Lanka.": {
    "footage": [
      {
        "https://images.pexels.com/photos/36847092/pexels-photo-36847092.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940": 3.5
      }
    ],
    "manual_intervention": false
  },
